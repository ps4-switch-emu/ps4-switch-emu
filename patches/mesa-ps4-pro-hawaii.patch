+/* The PS4 Pro's GPU in its enhanced mode (the PS4 winsys reports it as Bonaire with 4 shader
+ * engines): a 4-SE GFX7 part like Hawaii, and it hangs its work distributor the same way without
+ * Hawaii's IA/WD workarounds (seen on hardware: WD/IA/VGT/PA busy, SC idle, at the first draws). */
+static inline bool
+radv_hawaii_like(const struct radeon_info *gpu_info)
+{
+   return gpu_info->family == CHIP_HAWAII || (gpu_info->family == CHIP_BONAIRE && gpu_info->max_se == 4);
+}
