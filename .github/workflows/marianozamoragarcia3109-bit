name: Build PS4 pkg

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-24.04
    timeout-minutes: 350
    env:
      JOBS: "4"
    steps:
      - name: Free disk space
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL
          df -h /

      - uses: actions/checkout@v4
        with:
          submodules: recursive

      - name: Toolchain
        run: docker/run.sh scripts/setup-toolchain.sh

      - name: Mesa
        run: docker/run.sh scripts/build-mesa.sh

      - name: Emulator
        run: docker/run.sh scripts/build-eden.sh

      - name: Package
        run: docker/run.sh scripts/package-eden.sh 0.1.0

      - uses: actions/upload-artifact@v4
        with:
          name: ps4-switch-emu-pkg
          path: out/*.pkg
          if-no-files-found: error
